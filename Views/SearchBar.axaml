<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:UserControlDemo.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UserControlDemo.Views.SearchBar"
             Name="UserControl">
    
    <StackPanel Spacing="10">
        <TextBox PlaceholderText="{Binding $parent[local:SearchBar].Watermark}" Name="Bar"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 TextChanged="TextChanged" Loaded="Loaded"/>
        <ListBox ItemsSource="{Binding #UserControl.Results}" Name="ResultsListBox"
                 Background="Transparent"/>
    </StackPanel>
    
    
</UserControl>
